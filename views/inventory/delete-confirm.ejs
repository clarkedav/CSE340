<h1>Confirm Inventory Deletion</h1>

<!-- Flash / notice messages -->
<% if (messages && messages.notice && messages.notice.length> 0) { %>
    <div class="notice-box">
        <% messages.notice.forEach(function(msg) { %>
            <p>
                <%= msg %>
            </p>
            <% }) %>
    </div>
    <% } %>

        <% if (messages && messages.error && messages.error.length> 0) { %>
            <div class="error-box">
                <% messages.error.forEach(function(msg) { %>
                    <p>
                        <%= msg %>
                    </p>
                    <% }) %>
            </div>
            <% } %>

                <p class="delete-warning">⚠️ Confirm Deletion — This action is permanent and cannot be undone.</p>

                <form id="deleteForm" action="/inv/delete" method="post" novalidate>

                    <!-- Hidden input to pass inventory ID -->
                    <input type="hidden" name="inv_id" value="<%= sticky ? sticky.inv_id : '' %>">

                    <!-- Make -->
                    <label for="invMake">Make</label>
                    <input type="text" id="invMake" name="inv_make" value="<%= sticky ? sticky.inv_make : '' %>"
                        readonly>

                    <!-- Model -->
                    <label for="invModel">Model</label>
                    <input type="text" id="invModel" name="inv_model" value="<%= sticky ? sticky.inv_model : '' %>"
                        readonly>

                    <!-- Year -->
                    <label for="invYear">Year</label>
                    <input type="number" id="invYear" name="inv_year" value="<%= sticky ? sticky.inv_year : '' %>"
                        readonly>

                    <!-- Price -->
                    <label for="invPrice">Price</label>
                    <input type="number" id="invPrice" name="inv_price" value="<%= sticky ? sticky.inv_price : '' %>"
                        readonly>

                    <button type="submit" class="delete-btn">Delete Vehicle</button>
                </form>