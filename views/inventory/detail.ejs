<% if (messages && messages.notice && messages.notice.length> 0) { %>
    <div class="notice-box">
        <% messages.notice.forEach(function(msg) { %>
            <p>
                <%= msg %>
            </p>
            <% }) %>
    </div>
    <% } %>

        <%- vehicleHTML %>

            <!-- Reviews Section -->
            <section class="reviews-section">
                <h2>Customer Reviews</h2>

                <!-- Average Rating -->
                <% if (ratingData && ratingData.total_reviews> 0) { %>
                    <div class="avg-rating">
                        <span class="stars">
                            <% for (let i=1; i <=5; i++) { %>
                                <span class="<%= i <= ratingData.avg_rating ? 'star filled' : 'star' %>">★</span>
                                <% } %>
                        </span>
                        <span>
                            <%= ratingData.avg_rating %> out of 5 (<%= ratingData.total_reviews %> review<%=
                                        ratingData.total_reviews !==1 ? 's' : '' %>)
                        </span>
                    </div>
                    <% } else { %>
                        <p class="no-reviews">No reviews yet. Be the first to review!</p>
                        <% } %>

                            <!-- Validation errors -->
                            <% if (errors && errors.length> 0) { %>
                                <div class="error-box">
                                    <% errors.forEach(function(err) { %>
                                        <p>
                                            <%= err.msg %>
                                        </p>
                                        <% }) %>
                                </div>
                                <% } %>

                                    <!-- Add Review Form (logged in users only) -->
                                    <% if (locals.loggedin) { %>
                                        <div class="review-form-container">
                                            <h3>Leave a Review</h3>
                                            <form action="/review/add" method="POST" class="review-form">
                                                <input type="hidden" name="inv_id" value="<%= vehicle_id %>">

                                                <label for="review_rating">Rating</label>
                                                <div class="star-input">
                                                    <% for (let i=1; i <=5; i++) { %>
                                                        <input type="radio" id="star<%= i %>" name="review_rating"
                                                            value="<%= i %>" <%=sticky && sticky.review_rating==i
                                                            ? 'checked' : '' %> required>
                                                        <label for="star<%= i %>" class="star-label">★</label>
                                                        <% } %>
                                                </div>

                                                <label for="review_text">Your Review</label>
                                                <textarea id="review_text" name="review_text" rows="4" required
                                                    minlength="10"
                                                    placeholder="Share your experience with this vehicle..."><%= sticky ? sticky.review_text : '' %></textarea>

                                                <button type="submit">Submit Review</button>
                                            </form>
                                        </div>
                                        <% } else { %>
                                            <p class="login-to-review"><a href="/account/login">Log in</a> to leave a
                                                review.</p>
                                            <% } %>

                                                <!-- Display Reviews -->
                                                <% if (reviews && reviews.length> 0) { %>
                                                    <div class="reviews-list">
                                                        <% reviews.forEach(function(review) { %>
                                                            <div class="review-card">
                                                                <div class="review-header">
                                                                    <span class="reviewer-name">
                                                                        <%= review.account_firstname %>
                                                                            <%= review.account_lastname[0] %>.
                                                                    </span>
                                                                    <span class="review-stars">
                                                                        <% for (let i=1; i <=5; i++) { %>
                                                                            <span
                                                                                class="<%= i <= review.review_rating ? 'star filled' : 'star' %>">★</span>
                                                                            <% } %>
                                                                    </span>
                                                                    <span class="review-date">
                                                                        <%= new
                                                                            Date(review.review_date).toLocaleDateString()
                                                                            %>
                                                                    </span>
                                                                </div>
                                                                <p class="review-text">
                                                                    <%= review.review_text %>
                                                                </p>

                                                                <!-- Delete button only for review owner -->
                                                                <% if (locals.loggedin &&
                                                                    locals.accountData.account_id===review.account_id) {
                                                                    %>
                                                                    <form action="/review/delete" method="POST"
                                                                        class="delete-review-form">
                                                                        <input type="hidden" name="review_id"
                                                                            value="<%= review.review_id %>">
                                                                        <input type="hidden" name="inv_id"
                                                                            value="<%= vehicle_id %>">
                                                                        <button type="submit"
                                                                            class="delete-review-btn">Delete
                                                                            Review</button>
                                                                    </form>
                                                                    <% } %>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
            </section>