<h1>Add New Classification</h1>

<!-- Flash messages -->
<% if (messages.notice) { %>
    <div class="notice-box">
        <% messages.notice.forEach(function(msg){ %>
            <p>
                <%= msg %>
            </p>
            <% }) %>
    </div>
    <% } %>

                <form method="post" action="/inv/add-classification">
                    <label for="classification_name">Classification Name</label>
                    <input type="text" name="classification_name" id="classification_name" required
                        pattern="^[A-Za-z0-9]+$" title="No spaces or special characters allowed."
                        value="<%= sticky ? sticky.classification_name : '' %>">

                    <button type="submit">Add Classification</button>
                </form>