<header class="site-header">
    <div class="branding">
        <h1 class="logo">CSE Motors</h1>
        <nav class="account-nav">
            <% if (locals.loggedin) { %>
                <a href="/account/" class="account-link logged-in-text">
                    Welcome <%= locals.accountData.account_firstname %>
                </a>
                <a href="/account/logout" class="account-link">Logout</a>
                <% } else { %>
                    <a href="/account/login" class="account-link">My Account</a>
                    <% } %>
        </nav>
    </div>
    <nav class="main-nav">
        <%- locals.nav || '' %>
    </nav>
</header>