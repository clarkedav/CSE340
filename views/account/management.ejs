<% if (messages && messages.notice && messages.notice.length> 0) { %>
    <div id="flashMessage" class="notice-box">
        <% messages.notice.forEach(function(msg) { %>
            <p>
                <%= msg %>
            </p>
            <% }) %>
    </div>
    <% } %>

        <% if (messages && messages.error && messages.error.length> 0) { %>
            <div id="flashMessage" class="error-box">
                <% messages.error.forEach(function(msg) { %>
                    <p>
                        <%= msg %>
                    </p>
                    <% }) %>
            </div>
            <% } %>

                <main class="account-management">
                    <h1>
                        <%= title %>
                    </h1>

                    <!-- Greet by first name -->
                    <h2>Welcome <%= locals.accountData ? locals.accountData.account_firstname : '' %>
                    </h2>

                    <!-- Update account link - visible to ALL users -->
                    <p>
                        <a href="/account/update/<%= locals.accountData ? locals.accountData.account_id : '' %>"
                            class="update-link">
                            Update Account Information
                        </a>
                    </p>

                    <!-- My Reviews link - visible to ALL users -->
                    <p>
                        <a href="/review/my-reviews" class="update-link">My Reviews</a>
                    </p>

                    <!-- Only Employee or Admin sees Inventory Management -->
                    <% if (locals.accountData && (locals.accountData.account_type==='Employee' ||
                        locals.accountData.account_type==='Admin' )) { %>
                        <h3>Inventory Management</h3>
                        <p><a href="/inv/" class="inv-link">Manage Inventory</a></p>
                        <% } %>
                </main>

                <script>
                    const flash = document.getElementById("flashMessage")
                    if (flash) {
                        setTimeout(() => { flash.style.display = "none" }, 5000)
                    }
                </script>