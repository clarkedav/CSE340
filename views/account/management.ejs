<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <main class="form-container">
        <h1>
            <%= title %>
        </h1>

        <% if (messages.notice) { %>
            <div class="notice-box">
                <% messages.notice.forEach(msg=> { %>
                    <p>
                        <%= msg %>
                    </p>
                    <% }) %>
            </div>
            <% } %>

                <% if (errors && errors.length> 0) { %>
                    <div class="flash-error">
                        <% errors.forEach(err=> { %>
                            <p>
                                <%= err.msg %>
                            </p>
                            <% }) %>
                    </div>
                    <% } %>

                    <p><span class="logged-in-text">You're logged in.</span></p>
    </main>
</body>

</html>